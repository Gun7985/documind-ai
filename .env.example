# Supabase project URL used by server-side integrations and approved client configuration.
SUPABASE_URL=

# Public Supabase anon/publishable key. Never place a service-role key in browser configuration.
SUPABASE_ANON_KEY=

# Public values explicitly allowed in the Vite/React bundle. Never use the VITE_ prefix for server secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=

# Spring Boot runtime profile and HTTP port.
SPRING_PROFILES_ACTIVE=
SERVER_PORT=

# Expected Supabase JWT issuer and audience validated by Spring Security.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=

# Private bucket name for uploaded PDFs.
SUPABASE_STORAGE_BUCKET=

# Authenticated secure-tunnel URL through which Spring Boot reaches the internal FastAPI service.
AI_SERVICE_INTERNAL_URL=

# Identifier or token name used for authenticated Spring Boot-to-FastAPI requests; set the secret outside Git.
AI_SERVICE_AUTH_TOKEN=

# Internal FastAPI bind host and port. Do not expose this service directly to the public internet.
AI_SERVICE_HOST=
AI_SERVICE_PORT=

# Local Ollama endpoint and model name used by FastAPI.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
